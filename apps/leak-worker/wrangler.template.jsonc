// Rendered to wrangler.jsonc by tooling/wire/render.mjs (deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "leakbook-leak-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  "vars": {
    "ENVIRONMENT": "local"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage"
      },
      // LB3: the daily repair-clock sweep. 14:00 UTC is early morning across
      // the US, so a reminder is in the office's inbox for the working day.
      "triggers": {
        "crons": ["0 14 * * *"]
      },
      // The export bucket, bound by the name the runner creates: it prefixes
      // namespacePrefix ("stg-") onto infra/terraform/cloudflare-r2's name (runbook trap 26).
      "r2_buckets": [
        {
          "binding": "EXPORTS",
          "bucket_name": "stg-leakbook-exports-stage"
        }
      ],
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "leakbook-stage",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "leakbook-membership-worker-stage"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "leakbook-policy-worker-stage"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "leakbook-notifications-worker-stage"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod"
      },
      // LB3: the daily repair-clock sweep. 14:00 UTC is early morning across
      // the US, so a reminder is in the office's inbox for the working day.
      "triggers": {
        "crons": ["0 14 * * *"]
      },
      // The export bucket, bound by the name the runner creates: it prefixes
      // namespacePrefix ("prod-") onto infra/terraform/cloudflare-r2's name (runbook trap 26).
      "r2_buckets": [
        {
          "binding": "EXPORTS",
          "bucket_name": "prod-leakbook-exports-prod"
        }
      ],
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "leakbook-prod",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "leakbook-membership-worker-prod"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "leakbook-policy-worker-prod"
        },
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "leakbook-notifications-worker-prod"
        }
      ]
    }
  }
}
